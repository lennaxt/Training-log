rules_version = '2';

/* Zugriffsregeln fuer Firestore.
   Diese Datei ist nur die Quelle — sie wirkt erst, wenn sie in der
   Firebase-Konsole hinterlegt ist:
   Firebase-Konsole -> Firestore Database -> Regeln -> Inhalt einfuegen -> Veroeffentlichen.

   Ohne diese Regeln gilt weiter, was in der Konsole steht. Der Testmodus
   ("allow read, write: if true") laesst jeden mit dem oeffentlichen API-Key
   alle Trainingsdaten lesen und aendern — bei mehreren Nutzern nicht tragbar. */

service cloud.firestore {
  match /databases/{database}/documents {

    /* Jeder Nutzer sieht und schreibt genau sein eigenes Dokument.
       Die App legt es unter users/{uid} an (keyFor in index.html). */
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    /* Alt-Dokument aus der Einzelplatz-Zeit. Die App liest es einmalig, um die
       Daten nach users/{uid} zu uebernehmen — nur fuer das Konto, dem sie
       gehoeren. Kann geloescht werden, sobald die Uebernahme durch ist. */
    match /users/lennart {
      allow read: if request.auth != null
                  && request.auth.token.email == 'lennart.ising@icloud.com';
    }

    /* Alles andere ist zu. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
